<mxfile><diagram name="Balance confirmations" id="bc"><mxGraphModel dx="800" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Balance confirmations: proposed automated workflow (phase 1)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Grey = automatic, purple = automatic rules, orange = person clicks, green = stored record" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="900" height="24" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Customer replies, cc to owner&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Email + PDF (signed form or own balance)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="260" height="60" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Customer replies only to regional manager&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Owner not copied&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="260" height="60" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Regions save every reply in shared folder&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Including the ones cc to owner; auditors use it&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="260" height="60" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;Mailbox connector (optional)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Cross-check: flags mails not yet in the folder&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="260" height="60" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;Shared-folder watcher (main source)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Regions already save every reply here&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="280" width="260" height="60" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Intake and de-duplicate&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Same mail via owner and RM counted once (message ID, file hash, customer + period)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="580" height="60" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Link to evidence&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Each item keeps the path + hash of its file in the shared folder; nothing is moved&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="580" height="60" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Read the PDF&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Typed text read directly; printed scans via free local OCR; handwritten amount typed by owner&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="580" height="60" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Identify the customer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Customer ID on mail/PDF looked up in master, name must match; fuzzy match only if missing&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="580" height="60" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Compare balances&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Fixed rules, no LLM: same as ours = CLEAR, different = DISPUTE + their balance + difference&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="580" height="60" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;Consolidated list (ERP export)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;No., name, region, division, priority, BALANCE AS PER ERP&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="640" width="240" height="170" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Owner reviews every item&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Confirm / edit / follow up&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="225" y="840" width="250" height="120" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;Needs follow-up&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Unclear, unsigned, wrong date, partial. Owner contacts customer or RM; reply comes back through intake&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="855" width="240" height="90" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Fill that customer&amp;#x27;s row&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Customer balance, difference, clear/dispute, remarks, received date, status&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="580" height="60" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;Source link (internal)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Each row remembers its file; auditors keep using the folder&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="1000" width="240" height="60" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Recount MIS&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Region x division: total, P1/P2/P3, received, pending, % achievement&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="1100" width="270" height="60" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Draft MIS mail to boss&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#555555&#x27;&gt;Start / end of day; owner clicks Send&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="1100" width="270" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s1" target="i1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s3" target="i2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="i1" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="i2" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="m1" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="m1" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n5" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="unclear" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d1" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d1" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n6" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>